{
  "name": "medialab-recording",
  "version": "1.0.0",
  "description": "medialab recording - Windows screen recorder (Electron + React + FFmpeg)",
  "author": "medialab",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/tajawal": "^5.0.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "34.3.0",
    "electron-builder": "^24.13.3",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  },
  "build": {
    "appId": "com.medialab.recording",
    "productName": "medialab recording",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "overlay.html",
      "hud.html",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "icon": "public/recording_icon_transparent.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "medialab recording",
      "differentialPackage": false
    },
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "ar"
    ]
  }
}
